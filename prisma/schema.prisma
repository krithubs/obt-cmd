generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model AuditLog {
  id         String   @id
  action     String
  resource   String
  resourceId String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Complaint {
  id          String   @id
  ticketNo    String   @unique
  name        String
  phone       String
  type        String
  description String
  location    String?
  latitude    Float?
  longitude   Float?
  status      String   @default("PENDING")
  notes       String?
  images      String
  resolutionImages String @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignedTo  String?
  user       User?    @relation(fields: [assignedTo], references: [id])
}

model News {
  id              String   @id
  title           String
  content         String
  category        String
  images          String   @default("[]")
  privacySetting  String   @default("public")
  taggedUsers     String   @default("[]")
  locationName    String   @default("")
  feelingActivity String   @default("")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  authorId        String
  user            User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model User {
  id         String       @id
  email      String       @unique
  password   String
  name       String
  role       String       @default("STAFF")
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  audit_logs AuditLog[]
  complaints Complaint[]
  news       News[]
  permitRequests PermitRequest[]
}

model PermitType {
  id              String   @id
  name            String
  slug            String   @unique
  category        String   @default("general")
  description     String?
  formFileUrl     String?
  requiredDocs    String   @default("[]")
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  requiresPayment Boolean  @default(false)
  paymentQrUrl    String?
  defaultFee      Decimal? @db.Decimal(10, 2)
  paymentNote     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  requests        PermitRequest[]
}

model PermitRequest {
  id            String   @id
  requestNo     String   @unique
  trackingToken String   @unique
  permitTypeId  String
  permitType    PermitType @relation(fields: [permitTypeId], references: [id])
  fullName      String
  phone         String
  email         String?
  address       String?
  details       String
  documents     String   @default("[]")
  status        String   @default("SUBMITTED")
  feeAmount     Decimal? @db.Decimal(10, 2)
  paymentSlipUrl String?
  paidAt        DateTime?
  assignedTo    String?
  reviewer      User?    @relation(fields: [assignedTo], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  history       PermitStatusHistory[]
}

model PermitTypeTombstone {
  slug      String   @id
  reason    String?
  deletedAt DateTime @default(now())
}

model PermitStatusHistory {
  id          String   @id
  requestId   String
  request     PermitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  note        String?
  attachments String   @default("[]")
  changedBy   String?
  createdAt   DateTime @default(now())
}
